              "name": "Reserva SOC (%)",
              "icon": "mdi:battery-charging-high",
              "display_mode": "slider",
              "min": 10,
              "max": 100,
              "step": 5,
              "icon_color": "blue",
              "buttons": true
            },
            {
              "type": "custom:mushroom-number-card",
              "entity": "input_number.wifi_forced_charge_max_power",
              "name": "Potencia (%)",
